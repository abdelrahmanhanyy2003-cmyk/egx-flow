# =====================================================================
# EGX Flow - backend configuration. Copy to `.env` (project root or backend/).
# NEVER commit the real .env. Credentials stay server-side only.
# =====================================================================

# --- EFG Hermes Younit (read by the backend only; never sent to the browser)
TRADING_ID=
API_KEY=

# --- Infrastructure (blank DATABASE_URL = local SQLite file backend/data/egxflow.db)
DATABASE_URL=
# e.g. postgresql+psycopg://egxflow:egxflow@localhost:5432/egxflow
REDIS_URL=
# e.g. redis://localhost:6379/0  (optional)

APP_ENV=development
# demo = simulated EGX data (always labelled DEMO) ; live = EFG Hermes Younit
DATA_MODE=demo

# Optional shared secret protecting the local API/WebSocket. If set, enter the same
# value in the UI under Settings -> Local API access token.
APP_ACCESS_TOKEN=
# Browser origins allowed to call the API and open the WebSocket (the launchers set this for you).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100
# Host names the API answers to (blocks DNS-rebinding). Add your domain when hosting. "*" disables.
ALLOWED_HOSTS=localhost,127.0.0.1
# Per-IP REST budget and WebSocket caps
API_RATE_LIMIT_PER_MINUTE=600
WS_MAX_CLIENTS=64
WS_MAX_PER_IP=12
# Hosted showcase: simulated data only, all write endpoints disabled, API docs hidden.
# The app refuses to start with PUBLIC_DEMO=true unless DATA_MODE=demo.
PUBLIC_DEMO=false
LOG_LEVEL=INFO

# --- Market conventions (defaults for EGX; live market status overrides the calendar)
MARKET_TIMEZONE=Africa/Cairo
MARKET_CURRENCY=EGP
EGX_SESSION_OPEN=10:00
EGX_SESSION_CLOSE=14:30
# Python weekday numbers, Mon=0 .. Sun=6 (EGX: Sunday-Thursday)
EGX_TRADING_DAYS=6,0,1,2,3

# --- Engine tuning
HEATMAP_RESOLUTION_MS=1000
HEATMAP_HISTORY_COLUMNS=3600
HEATMAP_DEPTH_LEVELS=60
BROADCAST_INTERVAL_MS=250
STALE_AFTER_SECONDS=30
RECORD_MARKET_DATA=true
BOOK_SNAPSHOT_RECORD_S=1.0
# Recorded market data older than this is deleted hourly (0 = keep forever).
# Your journal and portfolio history are never deleted.
RECORD_RETENTION_DAYS=3
# Longest stretch of one recorded session loaded for replay
REPLAY_MAX_WINDOW_HOURS=6

# --- Demo simulator
DEMO_PREWARM_MINUTES=20
DEMO_SEED=7

# --- EFG Hermes Younit integration
EFG_MARKET_ID=1
# SDK docstring example uses index_id 1 for EGX30 - verify for your entitlement
EFG_EGX30_INDEX_ID=1
EFG_WATCH_SYMBOLS=COMI,ETEL,FWRY,EGAL,HRHO,TMGH,SWDY,EAST,ABUK,ORAS
# TradeUpdate.transaction_type is documented only as a "Buy/sell side indicator".
# Leave empty to classify aggressor side with quote/tick rules (flagged ESTIMATED).
# Only map it once you have confirmed with EFG Hermes that it is the AGGRESSOR side:
# EFG_TRANSACTION_TYPE_MAP=B:buy,S:sell
EFG_TRANSACTION_TYPE_MAP=
EFG_PORTFOLIO_POLL_S=30
EFG_MAX_REQUESTS_PER_MINUTE=60

# Frontend (public, non-secret): backend URL used by the browser
NEXT_PUBLIC_API_BASE=http://localhost:8000
